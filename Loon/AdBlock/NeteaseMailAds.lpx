#!name=网易邮箱大师净化
#!desc=网易邮箱大师净化
#!icon=https://wfordawn.github.io/Rewrite/icons/apps/NeteaseMailAds.jpg
#!tag=ddgksf2013
#!author=@ddgksf2013
#!version=2025-05-25

[Rewrite]
^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/page\/.*conf\.do response-body-json-jq '.data |= del(.masterLoginGuideList, .masterOperatorList, .functionOperatorInfoList, .memberOperator, .activityTabInfoList, .extList)'
^https?:\/\/mail\.163\.com\/fgw\/mailsrv-webrobot\/.*user\/info response-body-json-jq '.result |= del(.assistantInfo, .quotaData)'
^https?:\/\/dashi\.163\.com\/task-center-api\/fapi\/task - reject-dict
^https?:\/\/appconf\.mail\.163\.com\/mmad\/master\/get\.do - reject-200
^https?:\/\/appconf\.mail\.163\.com\/mailoperating\/mailmaster\/api\/operator\/get - reject-dict
^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/getRegConfig\.do - reject-dict
^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/config\/function\.do - reject-dict

[MITM]
hostname = dashi.163.com, appconf.mail.163.com, mail.163.com
