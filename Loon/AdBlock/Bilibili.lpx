#!name=哔哩哔哩去广告
#!desc=开屏/推荐页/动态/播放页/番剧页广告，协议级 + JSON 双层处理
#!icon=https://wfordawn.github.io/Rewrite/icons/apps/bilibili.png
#!tag=app2smile
#!author=@app2smile, @ddgksf2013, @blackmatrix7
#!version=2026-03-04

[Rewrite]
^https?:\/\/bilibili.2025.04.02/c136 - reject-200
^https?:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive - reject-dict
^https?:\/\/api\.bilibili\.com\/x\/vip\/ads\/material\/report - reject-dict
^https?:\/\/api\.bilibili\.com\/pgc\/season\/player\/cards - reject-dict
^https?:\/\/api\.bilibili\.com\/pgc\/season\/player\/ogv\/cards - reject-dict
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/(Flash|ListFlash|GetActivityTab) - reject-dict
^https?:\/\/app\.bilibili\.com\/x\/v\d\/search\/defaultwords - reject-dict
^https?:\/\/(app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.interface\.v1\.Search\/Default - reject-200

[Script]
# > 开屏/推荐页/动态 tab（JSON 层）
http-response ^https:\/\/app\.bilibili\.com\/x\/(v2\/(splash\/(list|show)|feed\/index\?)|resource\/show\/tab\/v2) script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/bilibili-json.js, requires-body=true, timeout=10, tag=bili-json
# > 视频页/动态/播放地址（协议级）
http-response ^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.(view\.v1\.View\/View|dynamic\.v2\.Dynamic\/DynAll|playurl\.v1\.PlayURL\/PlayView)$ script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/bilibili-proto.js, requires-body=true, binary-body-mode=true, timeout=10, tag=bili-proto
# > 番剧/影视页、直播、账号页（JSON 层补充）
http-response ^https?:\/\/api\.bili(api|bili)\.(net|com)\/pgc\/season\/app\/related\/recommend\? script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/bilibili.ads.js, requires-body=true, timeout=60, tag=bili-extra
http-response ^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v\d\/ecommerce-user\/get_shopping_info\? script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/bilibili.ads.js, requires-body=true, timeout=60, tag=bili-extra
http-response ^https?:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoByRoom script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/bilibili.ads.js, requires-body=true, timeout=60, tag=bili-extra
http-response ^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\? script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/bilibili.ads.js, requires-body=true, timeout=60, tag=bili-extra
http-response ^https?:\/\/api\.live\.bilibili\.com\/xlive\/app-interface\/v2\/index\/feed script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/bilibili.ads.js, requires-body=true, timeout=60, tag=bili-extra
http-response ^https?:\/\/api\.(bilibili|biliapi)\.(com|net)\/pgc\/page\/bangumi script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/bilibili.ads.js, requires-body=true, timeout=60, tag=bili-extra
http-response ^https?:\/\/api\.(bilibili|biliapi)\.(com|net)\/pgc\/page\/cinema\/tab\? script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/bilibili.ads.js, requires-body=true, timeout=60, tag=bili-extra

[MITM]
hostname = app.bilibili.com, grpc.biliapi.net
