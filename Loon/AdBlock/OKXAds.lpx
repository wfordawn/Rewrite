[Rewrite]
request if ${url} ~= /^https:\/\/[^\/]+\/priapi\/v3\/growth\/mobile\/card\/pro\/home-page/i then reject_dict(200)


[MITM]
hostname = *.okx.com, *.okx.ac, *.okx.cab, okx.com, okx.ac, okx.cab
