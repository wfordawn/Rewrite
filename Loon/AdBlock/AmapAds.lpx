#!name=高德地图净化
#!desc=如果有需要的去除广告的APP，可自行在共享表格中添加需求
#!icon=https://wfordawn.github.io/Rewrite/icons/apps/AmapAds.jpg
#!tag=ddgksf2013
#!author=@ddgksf2013
#!version=2025-12-06

[Rule]
DOMAIN-SUFFIX,optimus-ads.amap.com,DIRECT

[Rewrite]
^https?:\/\/.*\.amap\.com\/ws\/aos\/alimama\/splash_screen - reject-200
^https?:\/\/.*\.amap\.com\/v\d\/ai_rec\/ - reject-dict
^https?:\/\/.*\.amap\.com\/ws\/faas\/amap-navigation\/card-service-route-plan\? - reject-dict
^https?:\/\/.*\.amap\.com\/ws\/boss\/order_web\/\w{8}_information - reject-200
^https?:\/\/.*\.amap\.com\/ws\/asa\/ads_attribution - reject
^https?:\/\/.*\.amap\.com\/ws\/shield\/scene\/recommend - reject-dict
^https?:\/\/.*\.amap\.com\/uploadimg\/\w+\.gif - reject-img
^https?:\/\/.*\.amap\.com\/ws\/valueadded\/weather - reject-dict

[Script]
http-response ^http:\/\/amdc\.m\.taobao\.com script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/amdc.js, requires-body=true, timeout=60, tag=amdc

http-response ^https?:\/\/.*\.amap\.com\/ws\/message\/notice\/list script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/amap.js, requires-body=true, timeout=60, tag=amap

http-response ^https?:\/\/.*\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/amap.js, requires-body=true, timeout=60, tag=amap

http-response ^https?:\/\/.*\.amap\.com\/ws\/shield\/search\/nearbyrec_smart script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/amap.js, requires-body=true, timeout=60, tag=amap

http-response ^https?:\/\/.*\.amap\.com\/ws\/promotion-web\/resource script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/amap.js, requires-body=true, timeout=60, tag=amap

http-response ^https?:\/\/.*\.amap\.com\/ws\/faas\/amap-navigation\/main-page script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/amap.js, requires-body=true, timeout=60, tag=amap

http-response ^https?:\/\/.*\.amap\.com\/ws\/valueadded\/alimama\/splash_screen script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/amap.js, requires-body=true, timeout=60, tag=amap

http-response ^https?:\/\/.*\.amap\.com\/ws\/msgbox\/pull script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/amap.js, requires-body=true, timeout=60, tag=amap

http-response ^https?:\/\/.*\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaas script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/amap.js, requires-body=true, timeout=60, tag=amap

http-response ^https?:\/\/.*\.amap\.com\/ws\/shield\/search\/new_hotword script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/amap.js, requires-body=true, timeout=60, tag=amap

[MITM]
hostname = m5.amap.com, m5-zb.amap.com, center.amap.com, amap-aos-info-nogw.amap.com, ai.amap.com
