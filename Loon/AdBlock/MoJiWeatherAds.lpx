#!name=墨迹天气净化
#!desc=如果有需要的去除广告的APP，可自行在共享表格中添加需求
#!icon=https://wfordawn.github.io/Rewrite/icons/apps/MoJiWeatherAds.jpg
#!tag=ddgksf2013
#!author=@ddgksf2013
#!version=2025-11-03

[Rule]
DOMAIN-SUFFIX,adlaunch.moji.com,REJECT

[Rewrite]
^https?:\/\/.*api\.moji\.com\/json\/entrance\/list response-body-json-jq '.entrance_region_res_list |= map(select(.region_name | IN("工具区", "我页面灯泡", "banner区") | not))'
^https?:\/\/.*api\.moji\.com\/flycard\/flyCard - reject-200
^https?:\/\/.*api\.moji\.com\/shortvideo - reject-200
^https?:\/\/.*api\.moji\.com\/json\/advertising_goods - reject-200
^https?:\/\/.*api\.moji\.com\/forum - reject-200
^https?:\/\/.*api\.moji\.com\/user\/dynamic_v\d\/json\/someone_interest - reject-200
^https:\/\/tnc.*zijieapi\.com\/get_domains - reject-200

[MITM]
hostname = *.api.moji.com, tnc*-*.zijieapi.com
