#!name=Bing首页简化
#!desc=如果有需要的去除广告的APP，可自行在共享表格中添加需求
#!icon=https://wfordawn.github.io/Rewrite/icons/apps/BingSimplify.jpg
#!tag=ddgksf2013
#!author=@ddgksf2013
#!version=2023-12-18

[Rewrite]
^https?:\/\/assets\.msn\.com\/service\/weather\/locations\/search - reject-dict
# > bing_信息流@LE
^https:\/\/assets\.msn\.com\/service\/news\/feed\/pages\/startmhp - reject-dict
^https?:\/\/api\.msn\.com\/weather - reject-dict

[Script]
http-response ^https?:\/\/sapphire\.api\.microsoftapp\.net\/config\/api\/v1\/get script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/bing.js, requires-body=true, timeout=60, tag=bing

[MITM]
hostname = sapphire.api.microsoftapp.net, assets.msn.com, api.msn.com
