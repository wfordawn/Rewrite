[Script]
http-request ^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info))) script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/substore-1.min.js, requires-body=true, timeout=60, tag=sub-store-1.min
http-request ^https?:\/\/sub\.store script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/substore-0.min.js, requires-body=true, timeout=60, tag=sub-store-0.min

[MITM]
hostname = sub.store
