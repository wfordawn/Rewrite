#!name=BoxJs功能增强
#!desc=脚本管理和数据持久化工具，访问 boxjs.com 或 boxjs.net 即可使用
#!icon=https://wfordawn.github.io/Rewrite/icons/apps/BoxJs.png
#!tag=chavyleung
#!author=@chavyleung
#!version=2023-02-08

[Script]
http-request ^https?:\/\/(.+\.)?boxjs\.(com|net) script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/chavy.boxjs.js, requires-body=true, timeout=60, tag=chavy.boxjs

[MITM]
hostname = boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net
