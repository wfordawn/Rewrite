[Script]
cron "定时签到" script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/TieBa.js, timeout=300, tag=百度贴吧[签到]
http-request ^https?:\/\/(c\.tieba|tiebac)\.baidu\.com\/c\/s\/login script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/TieBa.js, requires-body=false, timeout=60, tag=禁用脚本

[MITM]
hostname = c.tieba.baidu.com, tiebac.baidu.com
