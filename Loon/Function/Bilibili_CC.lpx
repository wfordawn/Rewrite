[Script]
http-response ^https?:\/\/.*\.hdslb\.com\/bfs\/subtitle\/.+\.json script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/bilibili_cc.js, requires-body=true, timeout=60, tag=bilibili_cc

[MITM]
hostname = aisubtitle.hdslb.com, i0.hdslb.com
