[Script]
cron "定时签到" script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/KKMH.js, timeout=300, tag=快看漫画[签到]
http-request ^https?:\/\/api\.kkmh\.com\/v\d\/passport\/user script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/KKMH.js, requires-body=false, timeout=60, tag=禁用脚本

[MITM]
hostname = api.kkmh.com
