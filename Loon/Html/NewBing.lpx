[Script]
http-request ^https?:\/\/www\.bing\.com\/(search|new|web) script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/scripthub_replace-header.js, timeout=30, tag=replaceHeader, argument=(%5Cr%5Cn)(User-Agent%3A.%2B)(%5Cr%5Cn)-%3E%241%242%243

[MITM]
hostname = www.bing.com
