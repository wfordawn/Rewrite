[Script]
http-response ^https?:\/\/www\.google\..*\/search script-path=https://raw.githubusercontent.com/wfordawn/Rewrite/master/Loon/Scripts/endlessgoogle.js, requires-body=true, timeout=60, tag=endlessgoogle

[MITM]
hostname = www.google.*
